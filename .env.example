# MongoDB — copy these two lines from Primary SP Dashboard `.env.local`
# Path: C:\Users\shiba\OneDrive\Desktop\Primary SP Dashboard\.env.local
#
# Required for local + Vercel + Render (same Atlas cluster / DB as Primary):
#   MONGODB_URI=mongodb+srv://...
#   MONGODB_DB=sp_dashboard
#
# Local Docker alternative:
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sp_dashboard

# After pointing .env.local at Atlas (Primary values):
#   npm run sync:seed
#   npm run sync:master
#   npm run sync:index-2001
#   npm run verify:nsp-excel

# Render only:
# NODE_VERSION=20
# NODE_OPTIONS=--max-old-space-size=1536

# Not required for Dynamic Probability Calculator (Node pivot):
# PYTHON_API_URL=http://127.0.0.1:8000
