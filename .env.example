# MongoDB — local development (recommended)
# Start: docker compose up -d   OR   .\start-dashboard.ps1
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sp_dashboard

# Optional: MongoDB Atlas (cloud) — same cluster as Primary SP Dashboard
# Copy MONGODB_URI / MONGODB_DB from Primary SP `.env.local`
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB=sp_dashboard

# After pointing .env.local at Atlas, seed index history from 2001:
#   npm run sync:index-2001
#   npm run verify:nsp-excel

# Optional host parts (non-SRV)
# MONGODB_HOST=127.0.0.1
# MONGODB_PORT=27017
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_AUTH_SOURCE=admin
# MONGODB_TLS=false

# Start local Mongo: docker compose up -d
# Test local Mongo: npm run verify:mongo
# Seed local DB once: npm run sync:seed
# Refresh baked data from xlsx: npm run bake

# Optional Python pivot API (not required — Node pivot fallback is default)
# PYTHON_API_URL=http://127.0.0.1:8000
