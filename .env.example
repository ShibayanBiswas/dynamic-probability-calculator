# MongoDB — local development (recommended)
# Start: docker compose up -d   OR   .\start-dashboard.ps1 / bash start-dashboard.sh
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=sp_dashboard

# Optional: MongoDB Atlas (cloud) — only if you prefer remote DB over local Docker
# MONGODB_URI=mongodb+srv://USER:PASS@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Option C: local host + auth parts (non-SRV)
# MONGODB_HOST=127.0.0.1
# MONGODB_PORT=27017
# MONGODB_USER=
# MONGODB_PASSWORD=
# MONGODB_AUTH_SOURCE=admin
# MONGODB_TLS=false

# Start local Mongo: docker compose up -d
# Test local Mongo: npm run verify:mongo
# Seed local DB once: npm run sync:seed  (products + Primary/Rollover explorer grids)
# Refresh baked data from xlsx: npm run bake

# Python analytics API — local dev uses 127.0.0.1; Vercel production uses Render
PYTHON_API_URL=http://127.0.0.1:8000
# PYTHON_API_URL=https://YOUR-SERVICE.onrender.com
