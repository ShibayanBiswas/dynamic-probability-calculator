    "verify:irr-phase-tenure": "npx tsx scripts/verify-irr-phase-tenure-parity.ts",
    "verify:seamlessness": "npx tsx scripts/verify-desk-seamlessness.ts",
    "verify:coupon-formula": "npx tsx scripts/verify-coupon-formula-parity.ts",
    "verify:valuation-pipeline": "npx tsx scripts/verify-valuation-pipeline.ts",
    "verify:31jul-nav": "npx tsx scripts/verify-31jul-nav-match.ts",
    "verify:asof-levels": "npx tsx scripts/verify-asof-vs-31jul-levels.ts",
    "verify:effective-target": "npx tsx scripts/verify-effective-target.ts",
    "verify:probability": "npx tsx scripts/verify-probability-parity.ts",
    "verify:series-floor": "npx tsx scripts/verify-series-floor-2001.ts",
    "verify:nsp-excel": "npx tsx scripts/verify-nsp-excel-parity.ts",
    "audit:initial-kpis": "npx tsx scripts/audit-initial-probability-kpis.ts",
    "audit:probability-edges": "npx tsx scripts/audit-probability-edge-cases.ts",
    "bench:probability": "npx tsx scripts/bench-probability.ts",
    "verify:probability-desk": "npm run typecheck && npm run verify:series-floor && npm run verify:probability && npm run verify:nsp-excel && npm run verify:exports && npm run verify:effective-target && npm run verify:obs-settlement && npm run verify:filter-parity && npm run verify:obs-due && npm run audit:probability-edges && npm run bench:probability",
    "verify:703-obs": "npx tsx scripts/verify-703-obs-blank-lock.ts",
    "verify:ui-conservation": "npx tsx scripts/verify-ui-logic-conservation.ts",
    "verify:explorer": "npx tsx scripts/verify-explorer-annotations.ts",
    "verify:exports": "npx tsx scripts/verify-screen-exports.ts",
    "verify:calc": "npx tsx scripts/verify-calculation-core.ts",
    "verify:edge-cases": "npx tsx scripts/verify-edge-cases.ts",
    "verify:data-quality": "npx tsx scripts/verify-data-quality-guards.ts",
    "verify:dynamic": "npx tsx scripts/verify-dynamic-master.ts",
    "verify:mongo": "npx tsx scripts/test-mongo-connection.ts",
    "verify:mongo-parity": "npx tsx scripts/verify-mongo-new-primary-parity.ts",
    "sync:master": "npx tsx scripts/sync-master-to-mongo.ts",
    "sync:seed": "npx tsx scripts/sync-seed-to-mongo.ts",
    "backfill:index-history": "npx tsx scripts/backfill-valuation-index-history.ts",
    "sync:index-2001": "npx tsx scripts/sync-index-prices-from-2001.ts",
    "refresh:index-levels": "npx tsx scripts/refresh-index-levels-from-yahoo.ts",
    "verify:index-levels": "npx tsx scripts/verify-and-sync-index-levels.ts",
    "verify:index-cards": "npx tsx scripts/verify-valuation-payoff-index-cards.ts",
    "verify:dynamic-lifecycle": "npx tsx scripts/verify-dynamic-lifecycle-valuation-date.ts",
    "build:new-primary": "npx tsx scripts/build-new-primary-sheet.ts",
    "verify:new-primary": "npx tsx scripts/verify-new-primary-merge.ts",
    "verify:new-primary-source": "npx tsx scripts/verify-new-primary-source.ts",
    "verify:master-ref": "npx tsx scripts/verify-master-reference-parity.ts",
    "sync:master-backup": "npx tsx scripts/sync-master-from-backup.ts",
    "bake": "npx tsx scripts/build-new-primary-sheet.ts && npx tsx scripts/bake-master-seed.ts && npx tsx scripts/copy-master-to-public.ts",
    "bake:underlyings": "npx tsx scripts/bake-custom-underlying-history.ts",
    "trim:master": "npx tsx scripts/trim-master-workbook.ts"
  },
  "dependencies": {
    "@emnapi/core": "1.11.3",
    "@emnapi/runtime": "1.11.3",
    "@emnapi/wasi-threads": "1.2.3",
    "@tanstack/react-virtual": "3.14.9",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "exceljs": "4.4.0",
    "framer-motion": "12.43.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "0.539.0",
    "mongodb": "7.4.0",
    "next": "16.2.12",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "3.1.2",
    "tailwind-merge": "3.3.1",
    "xlsx": "0.18.5",
    "zod": "4.0.17"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.5",
    "@types/node": "24.3.0",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "autoprefixer": "10.4.21",
    "eslint": "9.33.0",
    "eslint-config-next": "16.2.12",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.17",
    "tsx": "4.20.4",
    "typescript": "5.9.2"
  },
  "overrides": {
    "motion-dom": "12.43.0",
    "motion-utils": "12.39.0"
  }
