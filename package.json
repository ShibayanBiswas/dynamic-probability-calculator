{
  "name": "dynamic-probability-calculator",
  "version": "0.1.0",
  "private": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "npm run copy:assets && next dev --port 3001",
    "dev:all": "bash start-dashboard.sh",
    "dev:local": "bash start-dashboard.sh",
    "build": "npm run copy:assets && next build",
    "copy:assets": "npm run copy:seed && npm run copy:master",
    "copy:seed": "npx tsx scripts/copy-seed-to-public.ts",
    "copy:master": "npx tsx scripts/copy-master-to-public.ts",
    "start": "next start --port 3001",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "verify:stack": "npm run typecheck && npm run lint && npm run build && npm run verify:headline && npm run verify:kpis",
    "verify:headline": "npx tsx scripts/verify-headline-regression.ts",
    "verify:desk": "npx tsx scripts/verify-desk-health.ts",
    "verify": "npx tsx scripts/bake-master-seed.ts && npx tsx scripts/verify-new-primary-source.ts && npx tsx scripts/verify-products.ts && npx tsx scripts/verify-full-suite.ts",
    "verify:full": "npx tsx scripts/verify-full-suite.ts",
    "verify:kpis": "npx tsx scripts/verify-lifecycle-kpis.ts",
    "verify:filter-parity": "npx tsx scripts/verify-lifecycle-filter-parity.ts",
    "verify:obs-due": "npx tsx scripts/verify-observation-due-filters.ts",
    "verify:obs-settlement": "npx tsx scripts/verify-observation-settlement.ts",
    "verify:analytics": "npx tsx scripts/verify-analytics-plots.ts",
    "verify:valuation": "npx tsx scripts/verify-valuation-working-parity.ts",
    "verify:ongoing": "npx tsx scripts/verify-ongoing-valuation.ts",
    "verify:expired": "npx tsx scripts/verify-expired-valuation.ts",
    "verify:expired-phase": "npx tsx scripts/verify-expired-phase-logic.ts",
    "verify:lifecycle-full": "npx tsx scripts/verify-lifecycle-valuation-full.ts",
    "verify:full-coupon": "npx tsx scripts/verify-full-coupon-logic.ts",
    "verify:all-metrics": "npx tsx scripts/verify-all-product-metrics.ts",
    "verify:ongoing-coupons": "npx tsx scripts/audit-ongoing-coupon-formed.ts",
    "verify:custom-underlyings": "npx tsx scripts/verify-custom-underlyings.ts",
    "verify:payoff-xirr": "npx tsx scripts/verify-payoff-xirr-tenor.ts",
    "verify:payoff-levels": "npx tsx scripts/verify-payoff-initial-target.ts",
    "verify:rollover-phase": "npx tsx scripts/verify-rollover-phase-tenor.ts",
    "verify:phase-logic": "npx tsx scripts/verify-phase-logic-audit.ts",
    "verify:irr-phase-tenure": "npx tsx scripts/verify-irr-phase-tenure-parity.ts",
    "verify:seamlessness": "npx tsx scripts/verify-desk-seamlessness.ts",
    "verify:coupon-formula": "npx tsx scripts/verify-coupon-formula-parity.ts",
    "verify:valuation-pipeline": "npx tsx scripts/verify-valuation-pipeline.ts",
    "verify:31jul-nav": "npx tsx scripts/verify-31jul-nav-match.ts",
    "verify:asof-levels": "npx tsx scripts/verify-asof-vs-31jul-levels.ts",
    "verify:effective-target": "npx tsx scripts/verify-effective-target.ts",
    "verify:probability": "npx tsx scripts/verify-probability-parity.ts",
    "bench:probability": "npx tsx scripts/bench-probability.ts",
    "verify:703-obs": "npx tsx scripts/verify-703-obs-blank-lock.ts",
    "verify:ui-conservation": "npx tsx scripts/verify-ui-logic-conservation.ts",
    "verify:explorer": "npx tsx scripts/verify-explorer-annotations.ts",
    "verify:exports": "npx tsx scripts/verify-screen-exports.ts",
    "verify:calc": "npx tsx scripts/verify-calculation-core.ts",
    "verify:edge-cases": "npx tsx scripts/verify-edge-cases.ts",
    "verify:data-quality": "npx tsx scripts/verify-data-quality-guards.ts",
    "verify:dynamic": "npx tsx scripts/verify-dynamic-master.ts",
    "verify:mongo": "npx tsx scripts/test-mongo-connection.ts",
    "verify:mongo-parity": "npx tsx scripts/verify-mongo-new-primary-parity.ts",
    "sync:master": "npx tsx scripts/sync-master-to-mongo.ts",
    "sync:seed": "npx tsx scripts/sync-seed-to-mongo.ts",
    "backfill:index-history": "npx tsx scripts/backfill-valuation-index-history.ts",
    "refresh:index-levels": "npx tsx scripts/refresh-index-levels-from-yahoo.ts",
    "verify:index-levels": "npx tsx scripts/verify-and-sync-index-levels.ts",
    "verify:index-cards": "npx tsx scripts/verify-valuation-payoff-index-cards.ts",
    "verify:dynamic-lifecycle": "npx tsx scripts/verify-dynamic-lifecycle-valuation-date.ts",
    "build:new-primary": "npx tsx scripts/build-new-primary-sheet.ts",
    "verify:new-primary": "npx tsx scripts/verify-new-primary-merge.ts",
    "verify:new-primary-source": "npx tsx scripts/verify-new-primary-source.ts",
    "verify:master-ref": "npx tsx scripts/verify-master-reference-parity.ts",
    "sync:master-backup": "npx tsx scripts/sync-master-from-backup.ts",
    "bake": "npx tsx scripts/build-new-primary-sheet.ts && npx tsx scripts/bake-master-seed.ts && npx tsx scripts/copy-master-to-public.ts",
    "bake:underlyings": "npx tsx scripts/bake-custom-underlying-history.ts",
    "trim:master": "npx tsx scripts/trim-master-workbook.ts"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.5",
    "clsx": "latest",
    "date-fns": "latest",
    "exceljs": "^4.4.0",
    "framer-motion": "latest",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "latest",
    "mongodb": "^7.4.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "recharts": "latest",
    "tailwind-merge": "latest",
    "xlsx": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.9",
    "postcss": "latest",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.22.4",
    "typescript": "latest"
  }
}
